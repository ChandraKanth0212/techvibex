# RAILOPT Command Center Environment Variables

VITE_APP_TITLE="RAILOPT Command Center"
VITE_USE_MOCK_DATA=true

# Phase 9A: opt-in switch for the REAL Module 3 optimizer API.
# While false, the existing mock services stay in charge and no optimizer
# request is made. Set to true only when Module 3 is running on the base URL below.
VITE_USE_REAL_OPTIMIZER_API=false

# API Base URLs for External Modules
VITE_MODULE_1_DATA_API=http://localhost:5000/api/v1
VITE_MODULE_2_AI_API=http://localhost:5001/api/v1
# Module 3 origin only: routes are mounted at /api/optimizer/*, there is no /api/v1 prefix.
VITE_MODULE_3_OPTIMIZER_API=http://localhost:5002

# Real-time WebSocket Endpoint
VITE_WS_ENDPOINT=ws://localhost:5000/ws
