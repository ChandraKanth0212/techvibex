{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoodsForecast",
  "description": "Canonical schema for freight demand and goods train movements forecast.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "forecastCode": { "type": "string" },
    "originHub": { "type": "string" },
    "destinationHub": { "type": "string" },
    "corridorId": { "type": "string", "format": "uuid" },
    "estimatedDeparture": { "type": "string", "format": "date-time" },
    "estimatedArrival": { "type": "string", "format": "date-time" },
    "cargoType": { "type": "string" },
    "priority": { "type": "integer", "minimum": 1, "maximum": 10 },
    "status": {
      "type": "string",
      "enum": ["FORECASTED", "CONFIRMED", "IN_TRANSIT", "COMPLETED", "CANCELLED"]
    },
    "sourceSystem": {
      "type": "string",
      "enum": ["TMS", "SMMS", "TDMS", "BDMS", "COA", "GOODS_FORECAST"]
    },
    "sourceRecordId": { "type": "string" },
    "ingestedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "forecastCode", "originHub", "destinationHub", "corridorId", "estimatedDeparture", "estimatedArrival", "cargoType", "priority", "status", "sourceSystem", "sourceRecordId"]
}
